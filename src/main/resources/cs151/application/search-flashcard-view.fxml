<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs151.application.SearchFlashcardController"
      styleClass="page">

    <VBox alignment="CENTER_LEFT" spacing="12" styleClass="form-card" maxWidth="760">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="Search Flashcards" styleClass="title"/>

        <TextField fx:id="searchField" promptText="Search by question, answer, or deck..."
                   styleClass="text-field" maxWidth="Infinity"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Search" onAction="#handleSearch" styleClass="primary-button" prefWidth="120"/>
            <Button text="Clear" onAction="#handleClear" styleClass="secondary-button" prefWidth="120"/>
        </HBox>

        <TableView fx:id="resultsTable" prefWidth="700" prefHeight="350">
            <columns>
                <TableColumn fx:id="questionColumn" text="Question" prefWidth="230"/>
                <TableColumn fx:id="answerColumn" text="Answer" prefWidth="230"/>
                <TableColumn fx:id="deckColumn" text="Deck" prefWidth="200"/>
            </columns>
        </TableView>

        <Label fx:id="statusLabel" text="" wrapText="true" styleClass="status-label"/>

        <Button text="Back" onAction="#handleBack" styleClass="secondary-button"/>
    </VBox>

</VBox>
