<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs151.application.DeckReviewController"
      styleClass="page">

    <VBox alignment="CENTER_LEFT" spacing="12" styleClass="form-card" maxWidth="640">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="Review Deck" styleClass="title"/>

        <Label text="Deck" styleClass="field-label"/>
        <TextField fx:id="deckNameField" editable="false" styleClass="text-field"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Filter" styleClass="field-label"/>
            <ComboBox fx:id="filterComboBox" onAction="#handleFilterChanged"/>
            <Label fx:id="progressLabel" text="0 of 0" styleClass="field-label"/>
        </HBox>

        <Label text="Front" styleClass="field-label"/>
        <TextArea fx:id="frontTextArea" prefRowCount="3" styleClass="text-field"/>

        <Label text="Back" styleClass="field-label"/>
        <TextArea fx:id="backTextArea" prefRowCount="3" styleClass="text-field"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Status" styleClass="field-label"/>
            <ComboBox fx:id="statusComboBox"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Created:" styleClass="field-label"/>
            <Label fx:id="createdAtLabel" text="—"/>
            <Label text="Last reviewed:" styleClass="field-label"/>
            <Label fx:id="lastReviewedLabel" text="Never"/>
        </HBox>

        <Label fx:id="statusLabel" text="" wrapText="true" styleClass="status-label"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="prevButton" text="Previous" onAction="#handlePrevious" styleClass="secondary-button"/>
            <Button fx:id="nextButton" text="Next" onAction="#handleNext" styleClass="secondary-button"/>
            <Button text="Save" onAction="#handleSave" styleClass="primary-button"/>
            <Button text="Back" onAction="#handleBack" styleClass="secondary-button"/>
        </HBox>

    </VBox>

</VBox>
