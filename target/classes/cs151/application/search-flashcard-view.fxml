<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs151.application.SearchFlashcardController"
      alignment="CENTER"
      spacing="15"
      styleClass="page">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Search Flashcards" styleClass="title"/>

    <TextField fx:id="searchField"
               promptText="Enter question or answer text"
               maxWidth="400"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
        <Button text="Show All" onAction="#handleShowAll" styleClass="secondary-button"/>
        <Button text="Delete Selected" onAction="#handleDeleteSelected" styleClass="secondary-button"/>
        <Button text="Back" onAction="#handleBackHome" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="flashcardTable" prefWidth="900" prefHeight="400">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="questionColumn" text="Question" prefWidth="220"/>
            <TableColumn fx:id="answerColumn" text="Answer" prefWidth="220"/>
            <TableColumn fx:id="deckColumn" text="Deck" prefWidth="160"/>
            <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="220"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" styleClass="status-label"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Show All" onAction="#handleShowAll"/>
        <Button text="Delete Selected" onAction="#handleDeleteSelected"/>
        <Button text="Back" onAction="#handleBackHome"/>
    </HBox>

</VBox>