<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs151.application.SearchFlashcardController"
      styleClass="page">

    <VBox alignment="CENTER_LEFT" spacing="12" styleClass="form-card" maxWidth="960">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="Search Flashcards" styleClass="title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Deck:" styleClass="field-label"/>
            <ComboBox fx:id="deckFilter" promptText="All Decks" prefWidth="220" onAction="#handleDeckSelected"/>
        </HBox>

        <TextField fx:id="searchField" promptText="Filter by question or answer..."
                   styleClass="text-field" maxWidth="Infinity"
                   onAction="#handleSearch"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Search" onAction="#handleSearch" styleClass="primary-button" prefWidth="120"/>
            <Button text="Show All" onAction="#handleShowAll" styleClass="secondary-button" prefWidth="120"/>
            <Button text="Delete Selected" onAction="#handleDeleteSelected" styleClass="secondary-button" prefWidth="140"/>
        </HBox>

        <Label text="Double-click a row to edit" styleClass="status-label"/>

        <TableView fx:id="flashcardTable" prefWidth="900" prefHeight="360">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="questionColumn" text="Question" prefWidth="230"/>
                <TableColumn fx:id="answerColumn" text="Answer" prefWidth="230"/>
                <TableColumn fx:id="deckColumn" text="Deck" prefWidth="180"/>
                <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="200"/>
            </columns>
        </TableView>

        <Label fx:id="statusLabel" text="" wrapText="true" styleClass="status-label"/>

        <Button text="Back" onAction="#handleBackHome" styleClass="secondary-button"/>
    </VBox>

</VBox>
